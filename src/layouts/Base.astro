---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import {
  dirOf,
  localePath,
  otherLanguagePath,
  pathWithoutLocale,
  strings,
  type Locale,
} from "../i18n";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  noindex?: boolean;
}

const { title, description, locale, noindex = false } = Astro.props;
const t = strings(locale);
const fullTitle = title === t.site.name ? title : `${title} | ${t.site.name}`;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const basePath = pathWithoutLocale(path);
const alternates = {
  en: new URL(localePath("en", basePath), Astro.site),
  he: new URL(localePath("he", basePath), Astro.site),
};
const nav = [
  { path: "/", label: t.nav.venues },
  { path: "/about/", label: t.nav.about },
  { path: "/contact/", label: t.nav.contact },
  { path: "/donate/", label: t.nav.donate },
].map((item) => ({ href: localePath(locale, item.path), label: item.label }));
---

<html lang={locale} dir={dirOf(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={alternates.en} />
    <link rel="alternate" hreflang="he" href={alternates.he} />
    <link rel="alternate" hreflang="x-default" href={alternates.en} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === "he" ? "he_IL" : "en_GB"} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      // Apply a saved light/dark choice before the first paint (no flash)
      try {
        const saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
      } catch {
        // storage unavailable: follow the device
      }
    </script>
  </head>
  <body class="min-h-dvh bg-paper text-ink">
    <header class="border-b border-rule">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3">
        <a
          href={localePath(locale, "/")}
          dir="ltr"
          class="font-stencil text-xl font-bold text-ink no-underline"
        >
          {t.site.name}
        </a>
        <nav
          aria-label={t.nav.menu}
          class="order-last flex w-full gap-5 text-sm sm:order-none sm:ms-auto sm:w-auto"
        >
          {nav.map((item) => (
            <a
              href={item.href}
              class="text-ink no-underline hover:underline aria-[current=page]:underline aria-[current=page]:decoration-2"
              aria-current={path === item.href ? "page" : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <div class="ms-auto flex items-center gap-2 sm:ms-0">
          <a
            href={otherLanguagePath(locale, path)}
            lang={t.locale.switchLang}
            hreflang={t.locale.switchLang}
            title={t.locale.switchTitle}
            class="rounded-full border border-rule px-3 py-1.5 text-sm text-ink no-underline hover:bg-sheet"
          >
            {t.locale.switchLabel}
          </a>
          <ThemeToggle locale={locale} />
        </div>
      </div>
    </header>
    <main class="mx-auto max-w-6xl px-4 pt-6 pb-16">
      <slot />
    </main>
    <footer class="border-t border-rule">
      <p class="mx-auto max-w-6xl px-4 py-6 text-sm text-muted">{t.site.tagline}</p>
    </footer>
  </body>
</html>
