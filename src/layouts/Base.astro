---
import Analytics from "@vercel/analytics/astro";
import "../styles/global.css";
import LanguageMenu from "../components/LanguageMenu.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { localePath, pathWithoutLocale, strings, type Locale } from "../i18n";
import { OG_HEIGHT, OG_WIDTH, ogImagePath } from "../lib/og-image";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  noindex?: boolean;
  /** The link preview picture (`/og/...`) and its description; the site's own card by default */
  image?: { path: string; alt: string };
}

const { title, description, locale, noindex = false } = Astro.props;
const t = strings(locale);
const fullTitle = title === t.site.name ? title : `${title} | ${t.site.name}`;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const basePath = pathWithoutLocale(path);
const image = Astro.props.image ?? {
  path: ogImagePath(locale),
  alt: `${t.site.name}. ${t.site.tagline}`,
};
const alternates = {
  en: new URL(localePath("en", basePath), Astro.site),
  he: new URL(localePath("he", basePath), Astro.site),
};
const nav = [
  { path: "/", label: t.nav.venues },
  { path: "/about/", label: t.nav.about },
  { path: "/contact/", label: t.nav.contact },
  { path: "/donate/", label: t.nav.donate },
].map((item) => ({ href: localePath(locale, item.path), label: item.label }));
const legalLinks = (["terms", "privacy", "accessibility"] as const).map((page) => ({
  href: localePath(locale, `/${page}/`),
  label: t.legal.footer[page],
}));
---

<!-- Every language keeps the same layout; Hebrew text reads right-to-left inside its block -->
<html lang={locale} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={alternates.en} />
    <link rel="alternate" hreflang="he" href={alternates.he} />
    <link rel="alternate" hreflang="x-default" href={alternates.en} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === "he" ? "he_IL" : "en_GB"} />
    <meta property="og:image" content={new URL(image.path, Astro.site)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      // Apply a saved light/dark choice before the first paint (no flash)
      try {
        const saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
      } catch {
        // storage unavailable: follow the device
      }
    </script>
  </head>
  <body class="min-h-dvh bg-paper text-ink">
    <header class="border-b border-rule">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3">
        <a
          href={localePath(locale, "/")}
          dir="ltr"
          class="font-stencil text-xl font-bold text-ink no-underline"
        >
          {t.site.name}
        </a>
        <nav
          aria-label={t.nav.menu}
          class="order-last flex w-full gap-5 text-sm sm:order-none sm:ms-auto sm:w-auto"
        >
          {nav.map((item) => (
            <a
              href={item.href}
              class="text-ink no-underline hover:underline aria-[current=page]:underline aria-[current=page]:decoration-2"
              aria-current={path === item.href ? "page" : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <div class="ms-auto flex items-center gap-2 sm:ms-0">
          <LanguageMenu locale={locale} />
          <ThemeToggle locale={locale} />
        </div>
      </div>
    </header>
    <main class="mx-auto max-w-6xl px-4 pt-6 pb-16">
      <slot />
    </main>
    <footer class="border-t border-rule">
      <div class="mx-auto flex max-w-6xl flex-wrap items-baseline gap-x-6 gap-y-2 px-4 py-6 text-sm text-muted">
        <p class="me-auto">{t.site.tagline}</p>
        <nav aria-label={t.legal.footer.label} class="flex flex-wrap gap-x-5 gap-y-2">
          {legalLinks.map((link) => (
            <a href={link.href} class="text-muted">
              {link.label}
            </a>
          ))}
        </nav>
      </div>
    </footer>
    <!-- Anonymous visit counts: no cookies, no stored IPs (see the privacy page) -->
    <Analytics />
  </body>
</html>
