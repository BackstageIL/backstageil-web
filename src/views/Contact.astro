---
/** Contact: one link per kind of request to the contribution form, and the email address. */
import { PUBLIC_CONTACT_EMAIL } from "astro:env/client";

import { strings, type Locale } from "../i18n";
import Base from "../layouts/Base.astro";
import { sendPath, type Kind } from "../lib/send";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = strings(locale).contact;
const kinds: Record<string, Kind> = {
  recommendation: "nearby",
  photos: "photos",
  correction: "correction",
  venue: "new_venue",
};
const requests = Object.entries(t.requests).map(([id, request]) => ({
  id,
  kind: kinds[id],
  ...request,
}));
---

<Base title={t.title} description={t.description} locale={locale}>
  <div class="max-w-2xl">
    <h1 class="font-stencil text-4xl font-bold sm:text-5xl">{t.title}</h1>
    <p class="mt-3 text-lg text-muted">{t.intro}</p>

    <ul class="mt-8 border-t border-rule">
      {requests.map((request) => (
        <li id={request.id} class="border-b border-rule py-4">
          <h2 class="font-stencil text-xl font-bold">{request.title}</h2>
          <p class="mt-1">{request.text}</p>
          <p class="mt-2">
            <a href={sendPath(locale, { kind: request.kind })}>{request.action}</a>
          </p>
        </li>
      ))}
    </ul>

    <p class="mt-6 text-sm text-muted">
      {t.addressLabel}:{" "}
      <a href={`mailto:${PUBLIC_CONTACT_EMAIL}`} dir="ltr">
        {PUBLIC_CONTACT_EMAIL}
      </a>
    </p>
  </div>
</Base>
