---
/** Send information (BSIL-58): the contribution form, with every venue and hall to choose from. */
import { PUBLIC_API_URL, PUBLIC_CONTACT_EMAIL } from "astro:env/client";

import SendForm, { sendTexts, type SendVenue } from "../components/SendForm";
import { nameIn, strings, type Locale } from "../i18n";
import Base from "../layouts/Base.astro";
import { api } from "../lib/site-api";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = strings(locale).send;
const byName = (a: { name: string }, b: { name: string }) =>
  a.name.localeCompare(b.name, locale, { sensitivity: "base" });
const details = await Promise.all((await api.listVenues()).map((v) => api.venue(v.slug)));
const venues: SendVenue[] = details
  .map((venue) => ({
    slug: venue.slug,
    name: nameIn(locale, venue),
    halls: venue.halls
      .map((hall) => ({ slug: hall.slug, name: nameIn(locale, hall) }))
      .sort(byName),
  }))
  .sort(byName);
---

<Base title={t.title} description={t.description} locale={locale}>
  <div class="max-w-2xl">
    <h1 class="font-stencil text-4xl font-bold sm:text-5xl">{t.title}</h1>
    <p class="mt-3 text-lg text-muted">{t.intro}</p>
    <SendForm
      client:load
      venues={venues}
      texts={sendTexts(t, PUBLIC_CONTACT_EMAIL)}
      apiUrl={PUBLIC_API_URL}
    />
  </div>
</Base>
