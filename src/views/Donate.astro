---
import { strings, type Locale } from "../i18n";
import Base from "../layouts/Base.astro";
import { KOFI_URL } from "../lib/links";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = strings(locale).donate;
---

<Base title={t.title} description={t.description} locale={locale}>
  <article class="max-w-2xl">
    <h1 class="font-stencil text-4xl font-bold sm:text-5xl">{t.title}</h1>
    {t.paragraphs.map((paragraph) => (
      <p class="mt-4 text-lg leading-relaxed">{paragraph}</p>
    ))}
    <p class="mt-8">
      <a
        href={KOFI_URL}
        rel="noopener"
        class="inline-block rounded bg-ink px-5 py-3 font-semibold text-paper no-underline hover:opacity-90"
      >
        {t.button}
      </a>
    </p>
  </article>
</Base>
