---
import { strings, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const label = strings(Astro.props.locale).theme.toggle;
---

<button
  type="button"
  data-theme-toggle
  aria-label={label}
  title={label}
  class="grid size-9 place-items-center rounded-full border border-rule text-ink"
>
  <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true">
    <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2"></circle>
    <path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"></path>
  </svg>
</button>

<script>
  // Switch to the opposite of what is shown now and remember the choice
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    button.addEventListener("click", () => {
      const root = document.documentElement;
      const shownDark =
        root.dataset.theme === "dark" ||
        (root.dataset.theme !== "light" && matchMedia("(prefers-color-scheme: dark)").matches);
      const next = shownDark ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {
        // storage unavailable: the choice lasts for this page only
      }
    });
  }
</script>
