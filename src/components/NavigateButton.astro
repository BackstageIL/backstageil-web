---
/** "Navigate with Waze" for a venue, plus a smaller Google Maps link: the way crews get there. */
import { strings, type Locale } from "../i18n";
import { mapsLink, wazeLink } from "../lib/nearby";

interface Props {
  locale: Locale;
  /** Venue name, street and city, for the navigation search */
  where: (string | null | undefined)[];
  size?: "large" | "small";
}

const { locale, where, size = "large" } = Astro.props;
const t = strings(locale).venue;
const button =
  size === "large" ? "px-4 py-2.5 text-base font-semibold" : "px-3 py-1.5 text-sm font-semibold";
---

<div class="flex flex-wrap items-center gap-x-4 gap-y-2">
  <a
    href={wazeLink(where)}
    rel="noopener"
    class={`inline-flex items-center gap-2 rounded bg-ink text-paper no-underline hover:opacity-90 ${button}`}
  >
    <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true">
      <path d="M12 2 4.5 21 12 17l7.5 4z" fill="currentColor"></path>
    </svg>
    <span dir="auto">{t.waze}</span>
  </a>
  <a href={mapsLink(where)} rel="noopener" class="text-sm">
    {t.map}
  </a>
  <slot />
</div>
