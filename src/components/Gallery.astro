---
/**
 * A hall's photos: thumbnails that open a full-size viewer (native <dialog>: Esc closes,
 * arrows and swipe move between photos). Files come straight from picture storage.
 */
import { strings, type Locale } from "../i18n";
import type { Picture } from "../lib/api";

interface Props {
  pictures: Picture[];
  hallName: string;
  locale: Locale;
}

const { pictures, hallName, locale } = Astro.props;
const t = strings(locale).hall;
const THUMB = 400; // longest edge of the stored thumbnails

const items = pictures.map((picture, index) => {
  const ratio = THUMB / Math.max(picture.width, picture.height, THUMB);
  return {
    ...picture,
    alt: picture.caption ?? t.photoAlt(index + 1, hallName),
    thumbWidth: Math.round(picture.width * ratio),
    thumbHeight: Math.round(picture.height * ratio),
  };
});
---

<ul class="grid grid-cols-2 gap-2 sm:grid-cols-3" data-gallery data-locale={locale}>
  {items.map((item, index) => (
    <li>
      <button
        type="button"
        data-index={index}
        data-src={item.url}
        data-width={item.width}
        data-height={item.height}
        data-caption={item.caption ?? ""}
        data-alt={item.alt}
        class="block w-full overflow-hidden rounded border border-rule bg-sheet"
      >
        <img
          src={item.thumbnail_url}
          alt={item.alt}
          width={item.thumbWidth}
          height={item.thumbHeight}
          loading="lazy"
          decoding="async"
          class="aspect-4/3 w-full object-cover"
        />
      </button>
    </li>
  ))}
</ul>

<dialog
  data-viewer
  aria-label={t.photos}
  class="m-auto max-h-dvh max-w-[min(100vw,72rem)] bg-transparent p-0 backdrop:bg-black/85"
>
  <figure class="relative">
    <img data-viewer-image alt="" class="max-h-[85dvh] w-auto rounded" />
    <figcaption class="mt-2 flex items-baseline justify-between gap-4 text-sm text-white">
      <span data-viewer-caption></span>
      <span data-viewer-counter class="font-stencil shrink-0"></span>
    </figcaption>
  </figure>
  <div class="mt-3 flex justify-center gap-3">
    <button type="button" data-viewer-previous class="viewer-button">
      {t.previous}
    </button>
    <button type="button" data-viewer-next class="viewer-button">
      {t.next}
    </button>
    <button type="button" data-viewer-close class="viewer-button">
      {t.close}
    </button>
  </div>
</dialog>

<style>
  .viewer-button {
    border: 1px solid rgb(255 255 255 / 0.4);
    border-radius: 0.25rem;
    padding: 0.5rem 0.9rem;
    color: white;
    font-size: 0.875rem;
  }
  .viewer-button:hover {
    background: rgb(255 255 255 / 0.12);
  }
</style>

<script>
  import { dirOf, strings, type Locale } from "../i18n";

  const gallery = document.querySelector<HTMLElement>("[data-gallery]");
  const locale: Locale = gallery?.dataset.locale === "he" ? "he" : "en";
  const viewer = document.querySelector<HTMLDialogElement>("[data-viewer]");
  const image = viewer?.querySelector<HTMLImageElement>("[data-viewer-image]");
  const caption = viewer?.querySelector<HTMLElement>("[data-viewer-caption]");
  const counter = viewer?.querySelector<HTMLElement>("[data-viewer-counter]");
  if (gallery && viewer && image && caption && counter) {
    const buttons = [...gallery.querySelectorAll<HTMLButtonElement>("button[data-index]")];
    let current = 0;

    const show = (index: number) => {
      current = (index + buttons.length) % buttons.length;
      const data = buttons[current].dataset;
      image.src = data.src ?? "";
      image.alt = data.alt ?? "";
      image.width = Number(data.width);
      image.height = Number(data.height);
      caption.textContent = data.caption ?? "";
      counter.textContent = strings(locale).hall.photoCounter(current + 1, buttons.length);
    };

    buttons.forEach((button, index) =>
      button.addEventListener("click", () => {
        show(index);
        viewer.showModal();
      }),
    );
    viewer
      .querySelector("[data-viewer-previous]")
      ?.addEventListener("click", () => show(current - 1));
    viewer.querySelector("[data-viewer-next]")?.addEventListener("click", () => show(current + 1));
    viewer.querySelector("[data-viewer-close]")?.addEventListener("click", () => viewer.close());
    // Back to the thumbnail that was opened, for keyboard users
    viewer.addEventListener("close", () => buttons[current]?.focus());
    // Click on the dark backdrop closes
    viewer.addEventListener("click", (event) => {
      if (event.target === viewer) viewer.close();
    });
    viewer.addEventListener("keydown", (event) => {
      // Arrows follow the reading direction: in Hebrew, left is "next"
      const forward = dirOf(locale) === "rtl" ? "ArrowLeft" : "ArrowRight";
      const back = forward === "ArrowLeft" ? "ArrowRight" : "ArrowLeft";
      if (event.key === back) show(current - 1);
      if (event.key === forward) show(current + 1);
    });
    // Swipe left/right on touch screens
    let startX: number | null = null;
    viewer.addEventListener("pointerdown", (event) => (startX = event.clientX));
    viewer.addEventListener("pointerup", (event) => {
      if (startX === null) return;
      const moved = event.clientX - startX;
      startX = null;
      // Swiping toward the reading start shows the next photo (left in English, right in Hebrew)
      const towardNext = dirOf(locale) === "rtl" ? moved > 0 : moved < 0;
      if (Math.abs(moved) > 50) show(current + (towardNext ? 1 : -1));
    });
  }
</script>
