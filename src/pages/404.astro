---
import { en } from "../i18n/en";
import Base from "../layouts/Base.astro";

const t = en.notFound;
---

<Base title={t.title} description={t.description} noindex>
  <div class="max-w-2xl">
    <h1 class="font-stencil text-4xl font-bold sm:text-5xl">{t.title}</h1>
    <p class="mt-3 text-lg">{t.text}</p>
    <p class="mt-6">
      <a href="/">{t.back}</a>
    </p>
  </div>
</Base>
