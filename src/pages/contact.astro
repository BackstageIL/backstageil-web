---
/** Contact: one email address, one pre-filled link per kind of request. */
import { PUBLIC_CONTACT_EMAIL } from "astro:env/client";

import { en } from "../i18n/en";
import Base from "../layouts/Base.astro";
import { mailto } from "../lib/contact";

const t = en.contact;
const requests = Object.entries(t.requests).map(([id, request]) => ({ id, ...request }));
---

<Base title={t.title} description={t.description}>
  <div class="max-w-2xl">
    <h1 class="font-stencil text-4xl font-bold sm:text-5xl">{t.title}</h1>
    <p class="mt-3 text-lg text-muted">{t.intro}</p>

    <ul class="mt-8 border-t border-rule">
      {requests.map((request) => (
        <li id={request.id} class="border-b border-rule py-4">
          <h2 class="font-stencil text-xl font-bold">{request.title}</h2>
          <p class="mt-1">{request.text}</p>
          <p class="mt-2">
            <a href={mailto(PUBLIC_CONTACT_EMAIL, request.subject)}>{request.action}</a>
          </p>
        </li>
      ))}
    </ul>

    <p class="mt-6 text-sm text-muted">
      {t.addressLabel}: <a href={`mailto:${PUBLIC_CONTACT_EMAIL}`}>{PUBLIC_CONTACT_EMAIL}</a>
    </p>
  </div>
</Base>
