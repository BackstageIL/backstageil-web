---
/** Home: find a venue by city, then venue; every hall with its stage size and outline. */
import VenueBrowser from "../components/VenueBrowser";
import { en } from "../i18n/en";
import Base from "../layouts/Base.astro";
import { api } from "../lib/site-api";
import { toListItems } from "../lib/venue-list";

const summaries = await api.listVenues();
const venues = toListItems(await Promise.all(summaries.map((venue) => api.venue(venue.slug))));
---

<Base title={en.site.name} description={en.site.tagline}>
  <h1 class="font-stencil max-w-3xl text-4xl leading-tight font-bold sm:text-6xl">
    {en.home.title}
  </h1>
  <p class="mt-3 max-w-2xl text-lg text-muted">{en.home.intro}</p>
  <div class="max-w-3xl">
    <VenueBrowser client:load venues={venues} />
  </div>
</Base>
