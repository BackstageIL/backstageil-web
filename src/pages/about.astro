---
import { en } from "../i18n/en";
import Base from "../layouts/Base.astro";

const t = en.about;
---

<Base title={t.title} description={t.description}>
  <article class="max-w-2xl">
    <h1 class="font-stencil text-4xl font-bold sm:text-5xl">{t.title}</h1>
    {t.paragraphs.map((paragraph) => (
      <p class="mt-4 text-lg leading-relaxed">{paragraph}</p>
    ))}
    <p class="mt-6">
      <a href="/contact/">{t.contactLink}</a>
    </p>
  </article>
</Base>
