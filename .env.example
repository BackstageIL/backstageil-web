# Copy to .env (git-ignored) and uncomment to override the defaults locally.
# Never commit real values.

# API the build reads (default: the production API), e.g. a local API:
# API_URL=http://127.0.0.1:8000

# Public URL of the site, for canonical links and the sitemap (default: the production domain)
# SITE_URL=https://www.backstageil.com

# Public contact address shown on the site (default: the project email)
# PUBLIC_CONTACT_EMAIL=
